		if tween then
			local state = tween.PlaybackState
			if
				state == Enum.PlaybackState.Begin
				or state == Enum.PlaybackState.Delayed
				or state == Enum.PlaybackState.Playing
			then
				tween.Completed:Wait()
			end
		end
		return self
	end

	-- Stops the running tween where it is.
	function Handle.stop(self: Handle): Handle
		local tween = self.tween
		if tween then
			self.tween = nil
			tween:Cancel()
		end
		return self
	end

	---- Events and input ----

	-- Connects to an event on the instance. The connection is cleaned up with the handle.
	function Handle.on(self: Handle, event: string, callback: (...any) -> ()): RBXScriptConnection
		assertAlive(self, "on")
		local ok, signal = pcall(function()
			return (self.instance :: any)[event]
		end)
		if not ok or typeof(signal) ~= "RBXScriptSignal" then
			error(`uniUI: {self.instance.ClassName} has no event "{event}"`, 2)
		end
		local connection = signal:Connect(callback)
		table.insert(self._connections, connection)
		return connection
	end

	-- Switches to `name` while the mouse is over the instance, then back to
	-- whatever state was showing before.
	function Handle.hover(self: Handle, name: string, options: AnimOptions?): Handle
		assertAlive(self, "hover")
		if not self:has(name) then
			error(`uniUI: unknown state "{name}" on {self.instance:GetFullName()}`, 2)
		end

		local previous = DEFAULT
		self:on("MouseEnter", function()
			if self.current ~= name then
				previous = self.current
				self:set(name, options)
			end
		end)
		self:on("MouseLeave", function()
			if self.current == name then
				self:set(if self:has(previous) then previous else DEFAULT, options)
			end
		end)
		return self
	end

	-- Turns user input on or off for this object and its descendants.
	function Handle.active(self: Handle, enabled: boolean): Handle
		assertAlive(self, "active")
		local instance = self.instance
		if instance:IsA("GuiObject") then
			instance.Active = enabled
			-- Interactable also blocks input to descendants.
			pcall(function()
				(instance :: any).Interactable = enabled
			end)
		end
		return self
	end

	---- Building ----

	-- Creates a child object and returns its handle, so trees can be built inline.
	function Handle.child(self: Handle, className: string, props: Props?): Handle
		assertAlive(self, "child")
		return Handle.create(className, self.instance, props)
	end

	-- Destroys the instance and everything the handle owns.
	function Handle.destroy(self: Handle)
		if self._destroyed then
			return
		end
		local instance = self.instance
		self:_cleanup()
		instance:Destroy()
	end

	---- Internal ----

	function Handle._play(self: Handle, props: Props, options: AnimOptions?)
		self:stop()
		local tween = Animation.apply(self.instance, props, options)
		self.tween = tween
		if tween then
			tween.Completed:Once(function()
				if self.tween == tween then
					self.tween = nil
				end
			end)
		end
	end

	function Handle._cleanup(self: Handle)
		if self._destroyed then
			return
		end
		self._destroyed = true
		self:stop()
		for _, connection in self._connections do
			connection:Disconnect()
		end
		table.clear(self._connections)
		Registry.remove(self.instance)
	end

	return Handle
end

__modules["Registry"] = function()
	-- Maps instances to their uniUI handles.
	--
	-- Entries are removed when the instance is destroyed (via its Destroying
	-- event, hooked up in Handle.new). An instance that is unparented but never
	-- destroyed keeps its entry, the same as any other Roblox reference.

	local Registry = {}

	local handles: { [Instance]: any } = {}

	function Registry.get(instance: Instance): any
		return handles[instance]
	end

	function Registry.set(instance: Instance, handle: any)
		handles[instance] = handle
	end

	function Registry.remove(instance: Instance)
		handles[instance] = nil
	end

	return Registry
end

__modules["Types"] = function()
	-- Shared types for uniUI.

	-- Animation options. Anything left out falls back to uniUI.defaults.
	type AnimOptions = {
		time: number?, -- Seconds. 0 applies the change instantly.
		style: Enum.EasingStyle?,
		direction: Enum.EasingDirection?,
		repeats: number?, -- -1 repeats forever.
		reverses: boolean?,
		delay: number?, -- Seconds before a tween starts. Instant properties are not delayed.
	}

	-- A property table, e.g. { BackgroundColor3 = Color3.new(1, 0, 0), Text = "Hi" }.
	type Props = { [string]: any }

	return {}
end

__modules["init"] = function()
	-- uniUI 5 — a small, script-based UI library for Roblox.
	-- https://github.com/jgamestaken/uniUI

	local Animation = __require("Animation")
	local Handle = __require("Handle")
	local Registry = __require("Registry")
	local Types = __require("Types")

	type Handle = Handle.Handle
	type AnimOptions = Types.AnimOptions
	type Props = Types.Props

	type Parent = Instance | Handle

	local VERSION = "5.0.0"

	local BASE_CLASSES: { [string]: boolean } = {
		ScreenGui = true,
		SurfaceGui = true,
		BillboardGui = true,
	}

	local function resolveParent(parent: Parent?): Instance?
		if parent == nil then
			return nil
		elseif typeof(parent) == "Instance" then
			return parent
		elseif type(parent) == "table" and typeof((parent :: any).instance) == "Instance" then
			return (parent :: Handle).instance
		end
		error("uniUI: parent must be an Instance, a uniUI handle, or nil", 3)
	end

	local uniUI = {
		version = VERSION,
		-- Default animation options. Change them with uniUI.configure.
		defaults = Animation.defaults,
	}

	-- Creates a ScreenGui, SurfaceGui or BillboardGui.
	-- ScreenGuis default to ResetOnSpawn = false.
	function uniUI.base(className: string, parent: Parent?, props: Props?): Handle
		if not BASE_CLASSES[className] then
			error(`uniUI.base: expected ScreenGui, SurfaceGui or BillboardGui, got "{className}"`, 2)
		end
		local initial = table.clone(props or {})
		if className == "ScreenGui" and initial.ResetOnSpawn == nil then
			initial.ResetOnSpawn = false
		end
		return Handle.create(className, resolveParent(parent), initial)
	end

	-- Creates a new UI object. Its starting props become its "default" state.
	function uniUI.new(className: string, parent: Parent?, props: Props?): Handle
		return Handle.create(className, resolveParent(parent), props)
	end

	-- Returns the handle for an existing instance, creating one if needed.
	-- Its "default" state fills in as other states are defined.
	function uniUI.wrap(instance: Instance): Handle
		return Registry.get(instance) or Handle.new(instance)
	end

	-- Clones a template (e.g. one built in Studio), applies props and returns its handle.
	function uniUI.clone(template: Instance, parent: Parent?, props: Props?): Handle
		local instance = template:Clone()
		local initial = props or {}
		for key, value in initial do
			Animation.setProperty(instance, key, value)
		end
		instance.Parent = resolveParent(parent)
		return Handle.new(instance, initial)
	end

	-- Returns the handle for an instance, or nil if it has none.
	function uniUI.get(instance: Instance): Handle?
		return Registry.get(instance)
	end

	-- Changes the default animation options, e.g. uniUI.configure({ time = 0.4 }).
	function uniUI.configure(options: AnimOptions)
		for key, value in options :: { [string]: any } do
			if (Animation.defaults :: any)[key] == nil then
				error(`uniUI.configure: unknown option "{key}"`, 2)
			end
			(Animation.defaults :: any)[key] = value
		end
	end

	return uniUI
end

return __require("init")
